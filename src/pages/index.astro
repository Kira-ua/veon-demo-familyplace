---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Napriamy from "../components/Napriamy.astro";
import Sadochky from "../components/Sadochky.astro";
import Tsentr from "../components/Tsentr.astro";
import Shkola from "../components/Shkola.astro";
import ProNas from "../components/ProNas.astro";
import Kontakty from "../components/Kontakty.astro";
import Footer from "../components/Footer.astro";
import CallBar from "../components/CallBar.astro";
import { phone, email, instagram, facebook } from "../data/familyplace";

const title = "Приватний садочок і центр розвитку в Ужгороді | FamilyPlace";
const description = "Два приватні садочки повного дня (Минай, Сторожниця), центр розвитку з гуртками від 1,6 р., початкова школа й табір в Ужгороді. Тел. +380 66 604 57 97";

// Structured data: only agreed values (address of the centre from the footer of every page, W-F009; hours from the contacts page).
const tel = phone.href.replace("tel:", "");
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    { "@type": "Organization", "@id": "#org", name: "FamilyPlace", telephone: tel, email: email.display, sameAs: [instagram.href, facebook.href] },
    {
      "@type": ["ChildCare", "LocalBusiness"], name: "FamilyPlace — центр розвитку і початкова школа", parentOrganization: { "@id": "#org" }, telephone: tel,
      address: { "@type": "PostalAddress", streetAddress: "вул. 128-ї бригади, 33а", addressLocality: "Ужгород", addressCountry: "UA" },
      openingHoursSpecification: [
        { "@type": "OpeningHoursSpecification", dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"], opens: "09:30", closes: "20:00" },
        { "@type": "OpeningHoursSpecification", dayOfWeek: "Saturday", opens: "10:00", closes: "15:00" },
      ],
    },
    { "@type": "Preschool", name: "FamilyPlace — садочок №1", parentOrganization: { "@id": "#org" }, telephone: tel, address: { "@type": "PostalAddress", streetAddress: "вул. Шевченка, 27", addressLocality: "с. Минай", addressCountry: "UA" } },
    { "@type": "Preschool", name: "FamilyPlace — садочок №2", parentOrganization: { "@id": "#org" }, telephone: tel, address: { "@type": "PostalAddress", streetAddress: "вул. Минайська, 2", addressLocality: "с. Сторожниця", addressCountry: "UA" } },
  ],
};
---
<Base lang="uk" title={title} description={description} mainRec="R-005,R-006">
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <Header slot="header" />
  <Hero />
  <Napriamy />
  <Sadochky />
  <Tsentr />
  <Shkola />
  <ProNas />
  <Kontakty />
  <Fragment slot="footer">
    <Footer />
    <CallBar />
  </Fragment>
</Base>
<script src="../scripts/page.ts"></script>
